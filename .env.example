# Copy to .env and fill in. Everything is optional for local use.
PORT=3000
NODE_ENV=production
# Long random string; keeps people signed in across restarts.
JWT_SECRET=change-me-to-a-long-random-string
# Timezone used for "today" and for reminders.
TZ_NAME=Asia/Kolkata
# Database. Leave empty to use a local file (./data/finance.db).
# On Vercel set these to your Turso database (https://turso.tech):
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=
# Shared secret Vercel Cron sends to /api/cron/evening and /api/cron/morning.
# CRON_SECRET=

# Starter passwords (only used the very first time the database is created; required on Vercel).
DARSH_PASSWORD=darsh123
BHAKTI_PASSWORD=bhakti123
ADMIN_PASSWORD=admin123

# ---- Free AI (pick one; leave all empty to use the built-in rule-based advisor) ----
# auto | groq | gemini | ollama | none
AI_PROVIDER=auto
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Leave the model lines empty to use the defaults; retired models fall back automatically.
GROQ_MODEL=
# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# Ollama (runs open models on your own machine for free): https://ollama.com
OLLAMA_URL=
OLLAMA_MODEL=llama3.1

# ---- Push notifications (optional; generated automatically if empty) ----
VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
